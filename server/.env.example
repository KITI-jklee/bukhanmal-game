# 필수. sqlite 폴백 없음(Vercel 등 서버리스는 파일 sqlite를 운영 DB로 못 씀).
# Supabase 대시보드 > Connect > Direct(또는 Connection Pooler) 문자열을 쓴다.
DATABASE_URL=postgresql+psycopg://user:pass@host:6543/dbname

# 선택. PostgreSQL/Supabase 통합 테스트 전용 DB(tests/integration/).
# DATABASE_URL과 같은 프로젝트를 쓸 거라면 절대 public 스키마를 그대로
# 가리키지 마라 — 통합테스트가 실제 운영 테이블에 대고 쿼리하게 된다(트랜잭션
# 롤백으로 커밋은 안 되지만, 굳이 그럴 이유가 없다). 대신 별도 스키마(예: test)를
# 만들고 supabase_schema.sql을 public 대신 그 스키마에 적용한 뒤, 아래처럼
# options=-c search_path=<스키마>로 접속 시점에 고정한다.
# 포트는 5432(세션 풀러)를 쓸 것 — 6543(트랜잭션 풀러)은 세션 상태(search_path)가
# 요청마다 안 지켜질 수 있다. URL 안의 공백은 반드시 %20으로 인코딩할 것 —
# 안 하면 libpq가 옵션을 조용히 무시하고 기본 search_path(=public)로 붙는다.
TEST_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname?options=-c%20search_path%3Dtest

# 프런트엔드 개발 서버·배포 도메인을 쉼표로 구분해 나열한다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 점수 등록 요청 빈도 제한 (API 명세서 C-1 429)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=10
EVENT_RATE_LIMIT_MAX_REQUESTS=30
EVENT_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_RATE_LIMIT_MAX_REQUESTS=10
ADMIN_RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_RETENTION_SECONDS=86400

# 산성비게임은 무한 생존이라 이론상 최대 점수가 없다. 명백히 조작된 값만
# 걸러내는 휴리스틱 상한 — 운영 데이터를 보고 발주처와 협의해 조정한다.
ACID_RAIN_SCORE_CEILING=300000

# 관리자 통계 화면(/admin) 보호용 단일 비밀번호. 발주처에 이 값을 전달해
# 화면에 입력하게 한다 — 별도 계정 시스템 없이 방문자·이용 지표만 보여주는
# 용도라 이 정도 보호로 충분하다고 판단했다. 운영 배포 전 반드시 바꿀 것.
ADMIN_PASSWORD=change-me

# 익명 플레이어 세션 HMAC 키. 관리자 비밀번호와 다른 32자 이상의 값이 필수다.
PLAYER_TOKEN_SECRET=replace-with-an-independent-random-secret-32-chars-minimum
# 플레이어 세션 유효기간(초). 기본 30일.
PLAYER_TOKEN_TTL_SECONDS=2592000

# 읽기 API 요청 제한
RANKING_RATE_LIMIT_MAX_REQUESTS=120
RANKING_RATE_LIMIT_WINDOW_SECONDS=60
RECENT_RATE_LIMIT_MAX_REQUESTS=60
RECENT_RATE_LIMIT_WINDOW_SECONDS=60
