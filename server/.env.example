# 운영 DB가 정해지면 이 값만 바꾼다. 예: postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=sqlite:///./scores.db

# 프런트엔드 개발 서버·배포 도메인을 쉼표로 구분해 나열한다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 점수 등록 요청 빈도 제한 (API 명세서 C-1 429)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=10

# 산성비게임은 무한 생존이라 이론상 최대 점수가 없다. 명백히 조작된 값만
# 걸러내는 휴리스틱 상한 — 운영 데이터를 보고 발주처와 협의해 조정한다.
ACID_RAIN_SCORE_CEILING=300000
